{
  "name": "jamify",
  "version": "0.1.0",
  "private": true,
  "description": "A music streaming prototype with shared 'jam' rooms. Inspired by Youtify (a fork of BlackHole) — independent implementation, no copied code/assets.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c yellow,cyan \"npm:server\" \"npm:web\"",
    "server": "tsx watch server/index.ts",
    "web": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "undici": "^6.21.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}